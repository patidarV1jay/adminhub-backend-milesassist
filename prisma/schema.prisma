
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TransactionType {
  PAYMENT
  REFUND
  TRANSFER
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}

enum TransactionStage {
  INITIATED
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum LocationType {
  VIRTUAL
  IN_PERSON
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

// ---------- Models ----------

model User {
  id               String     @id @default(uuid())
  number           Int        @unique @default(autoincrement()) // USR-{number}
  name             String
  email            String     @unique
  passwordHash     String
  phone            String?
  dateOfBirth      DateTime?  @db.Date
  address          String?
  avatarUrl        String?
  role             UserRole   @default(VIEWER)
  status           UserStatus @default(ACTIVE)
  twoFactorEnabled Boolean    @default(false)
  lastLoginAt      DateTime?
  lastActiveAt     DateTime?
  deletedAt        DateTime? // soft delete
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  transactions  Transaction[]
  bookings      Booking[]
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([name])
}

model Service {
  id                     String   @id @default(uuid())
  name                   String   @unique
  price                  Decimal  @db.Decimal(12, 2)
  defaultDurationMinutes Int
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id                 String        @id @default(uuid())
  number             Int           @unique @default(autoincrement()) // BKG-{number}
  customerId         String
  serviceId          String
  scheduledAt        DateTime
  durationMinutes    Int
  timezone           String        @default("EST")
  status             BookingStatus @default(PENDING)
  paymentStatus      PaymentStatus @default(PENDING)
  locationType       LocationType  @default(VIRTUAL)
  meetingLink        String?
  notes              String?
  amount             Decimal       @db.Decimal(12, 2)
  invoiceNumber      String?       @unique // INV-10294
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer     User           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service      Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  events       BookingEvent[]
  transactions Transaction[]

  @@index([status])
  @@index([paymentStatus])
  @@index([scheduledAt])
  @@index([customerId, scheduledAt])
  @@index([serviceId])
  @@index([createdAt])
}

model BookingEvent {
  id          String   @id @default(uuid())
  bookingId   String
  title       String // e.g. "Confirmation Sent"
  description String?
  occurredAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, occurredAt])
}

model Transaction {
  id                     String            @id @default(uuid())
  number                 Int               @unique @default(autoincrement()) // TXN-{number}
  gatewayReference       String?           @unique // REF-98342718
  userId                 String
  bookingId              String?
  originalTransactionId  String? // set on REFUND rows
  type                   TransactionType   @default(PAYMENT)
  status                 TransactionStatus @default(PENDING)
  amount                 Decimal           @db.Decimal(12, 2) // negative for refunds
  gatewayFee             Decimal           @default(0) @db.Decimal(12, 2)
  subtotal               Decimal           @db.Decimal(12, 2)
  currency               String            @default("USD") @db.VarChar(3)
  paymentMethod          String // e.g. "Credit Card", "PayPal"
  cardBrand              String?
  cardLast4              String?           @db.VarChar(4)
  description            String? // e.g. "Service Payment"
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking              Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  originalTransaction  Transaction?  @relation("Refunds", fields: [originalTransactionId], references: [id], onDelete: SetNull)
  refunds              Transaction[] @relation("Refunds")
  events               TransactionEvent[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([bookingId])
  @@index([amount])
}

model TransactionEvent {
  id            String           @id @default(uuid())
  transactionId String
  stage         TransactionStage
  title         String // e.g. "Completed & Disbursed"
  description   String?
  occurredAt    DateTime         @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, occurredAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String // e.g. "Logged in from new device"
  description String?
  metadata    Json? // IP, device, related entity ids
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SystemAlert {
  id          String        @id @default(uuid())
  severity    AlertSeverity
  title       String
  description String?
  isResolved  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isResolved, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String // recipient admin
  title     String
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
