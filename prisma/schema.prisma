generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  number           Int            @unique @default(autoincrement())
  name             String
  email            String         @unique
  passwordHash     String
  phone            String?
  dateOfBirth      DateTime?      @db.Date
  address          String?
  avatarUrl        String?
  role             UserRole       @default(VIEWER)
  status           UserStatus     @default(ACTIVE)
  twoFactorEnabled Boolean        @default(false)
  lastLoginAt      DateTime?
  lastActiveAt     DateTime?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  activityLogs     ActivityLog[]
  bookings         Booking[]
  notifications    Notification[]
  transactions     Transaction[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([name])
}

model Service {
  id                     String    @id @default(uuid())
  name                   String    @unique
  price                  Decimal   @db.Decimal(12, 2)
  defaultDurationMinutes Int
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  bookings               Booking[]
}

model Booking {
  id                 String         @id @default(uuid())
  number             Int            @unique @default(autoincrement())
  customerId         String
  serviceId          String
  scheduledAt        DateTime
  durationMinutes    Int
  timezone           String         @default("EST")
  status             BookingStatus  @default(PENDING)
  paymentStatus      PaymentStatus  @default(PENDING)
  locationType       LocationType   @default(VIRTUAL)
  meetingLink        String?
  notes              String?
  amount             Decimal        @db.Decimal(12, 2)
  invoiceNumber      String?        @unique
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  customer           User           @relation(fields: [customerId], references: [id])
  service            Service        @relation(fields: [serviceId], references: [id])
  events             BookingEvent[]
  transactions       Transaction[]

  @@index([status])
  @@index([paymentStatus])
  @@index([scheduledAt])
  @@index([customerId, scheduledAt])
  @@index([serviceId])
  @@index([createdAt])
}

model BookingEvent {
  id          String   @id @default(uuid())
  bookingId   String
  title       String
  description String?
  occurredAt  DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, occurredAt])
}

model Transaction {
  id                    String             @id @default(uuid())
  number                Int                @unique @default(autoincrement())
  gatewayReference      String?            @unique
  userId                String
  bookingId             String?
  originalTransactionId String?
  type                  TransactionType    @default(PAYMENT)
  status                TransactionStatus  @default(PENDING)
  amount                Decimal            @db.Decimal(12, 2)
  gatewayFee            Decimal            @default(0) @db.Decimal(12, 2)
  subtotal              Decimal            @db.Decimal(12, 2)
  currency              String             @default("USD") @db.VarChar(3)
  paymentMethod         String
  cardBrand             String?
  cardLast4             String?            @db.VarChar(4)
  description           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  booking               Booking?           @relation(fields: [bookingId], references: [id])
  originalTransaction   Transaction?       @relation("Refunds", fields: [originalTransactionId], references: [id])
  refunds               Transaction[]      @relation("Refunds")
  user                  User               @relation(fields: [userId], references: [id])
  events                TransactionEvent[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([bookingId])
  @@index([amount])
}

model TransactionEvent {
  id            String           @id @default(uuid())
  transactionId String
  stage         TransactionStage
  title         String
  description   String?
  occurredAt    DateTime         @default(now())
  transaction   Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, occurredAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SystemAlert {
  id          String        @id @default(uuid())
  severity    AlertSeverity
  title       String
  description String?
  isResolved  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isResolved, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TransactionType {
  PAYMENT
  REFUND
  TRANSFER
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}

enum TransactionStage {
  INITIATED
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum LocationType {
  VIRTUAL
  IN_PERSON
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}
